# ELMER BUSINESS INTELLIGENCE — placeholders only. Never commit real values.
# Copy to .env.local for development. See README.md for which are required.

# --- Firebase web config (REQUIRED; public by design, protected by Security Rules) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (REQUIRED, server-only, never NEXT_PUBLIC) ---
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the literal \n sequences inside the quotes.
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Access control (RECOMMENDED) ---
# Comma-separated emails allowed to sign in. If empty, sign-in is refused in production.
OWNER_EMAILS=

# --- Google Business Profile API (OPTIONAL; integration stays disabled when empty) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Encrypts API keys saved in Settings > AI providers (REQUIRED for that page) ---
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# --- AI Analyst (OPTIONAL; legacy env fallback. Providers are now managed in Settings > AI providers) ---
AI_PROVIDER=
AI_API_KEY=

# --- Local rank tracker provider (OPTIONAL; never enable a paid provider without owner approval) ---
RANK_TRACKER_PROVIDER=
RANK_TRACKER_API_KEY=
